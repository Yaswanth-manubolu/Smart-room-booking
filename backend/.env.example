# Copy this file to  .env  (same folder) and fill in your values, then restart the backend.

PORT=5002

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Yaswanth@95
DB_NAME=smart_room_booking_db

# ---- Login token secret (change it!) ----
JWT_SECRET=change_this_to_a_long_random_string

# ---- E-mail notifications (booking request -> user + admin) ----
# Gmail example: turn on 2-Step Verification, then create an "App password"
# (Google Account -> Security -> App passwords) and paste it below (no spaces).
SMTP_SERVICE=gmail
SMTP_USER=yourcollegemail@gmail.com
SMTP_PASS=your_16_char_app_password

# Not using Gmail? Comment out SMTP_SERVICE and use these instead:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# "From" line shown in the e-mails (optional)
MAIL_FROM="MITS Smart Room Booking" <yourcollegemail@gmail.com>

# Where admin booking-request e-mails go. Comma separate several addresses.
# If left empty, every user with the Administrator role receives them
# (the default seeded admin is admin@gmail.com – set a REAL mailbox here!).
ADMIN_EMAIL=

# Link shown inside the admin e-mail
APP_URL=http://localhost:5173

# Timezone used for "today", "now" and e-mail timestamps
APP_TIMEZONE=Asia/Kolkata
